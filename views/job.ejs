<%- include("partials/head") %>
<%- include("partials/header") %>

<h2><%= job ? "Edit Job" : "New Job" %></h2>

<form method="POST" action="<%= job ? '/jobs/update/' + job._id : '/jobs' %>">
  <div>
    <label for="company">Company</label>
    <input
      id="company"
      name="company"
      value="<%= job && job.company ? job.company : '' %>"
      required
    />
  </div>

  <div>
    <label for="position">Position</label>
    <input
      id="position"
      name="position"
      value="<%= job && job.position ? job.position : '' %>"
      required
    />
  </div>

  <div>
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="pending" <%= job && job.status === "pending" ? "selected" : "" %>>
        pending
      </option>
      <option value="interview" <%= job && job.status === "interview" ? "selected" : "" %>>
        interview
      </option>
      <option value="declined" <%= job && job.status === "declined" ? "selected" : "" %>>
        declined
      </option>
    </select>
  </div>

  <input type="hidden" name="_csrf" value="<%= _csrf %>" />

  <button type="submit"><%= job ? "Update" : "Create" %></button>
</form>

<%- include("partials/footer") %>